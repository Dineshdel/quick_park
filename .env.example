# ---- Backend (backend/) ----
NODE_ENV=development
PORT=4000
# Browser origin(s), comma-separated. The first is used for links in emails.
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false

# docker-compose defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quickpark?schema=public
REDIS_URL=redis://localhost:6379

# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# COOKIE_SECURE=true   # defaults to true when NODE_ENV=production

# Google Identity Services OAuth client ID (also used by the web app)
GOOGLE_CLIENT_ID=

# log = print emails to the API console; smtp = send via SMTP_URL (Mailpit: smtp://localhost:1025)
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=Quick Park <no-reply@quickpark.local>

# false = sign in right after registering (no verification email). Set true before launch.
REQUIRE_EMAIL_VERIFICATION=true

# ---- Frontend (frontend/) ----
# Where Next.js proxies /api/v1/* (same-origin cookies, no CORS in the browser)
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Maps (Maps JavaScript API + Places API (New)). Empty = OpenStreetMap fallback.
# Restrict the key to your site's HTTP referrers in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers (optional; DEMO_MAP_ID is used when empty)
NEXT_PUBLIC_GOOGLE_MAP_ID=

# ---- Files: local disk in development, S3 in production ----
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_REGION=ap-south-1
# S3_PUBLIC_BUCKET=quickpark-public
# S3_PRIVATE_BUCKET=quickpark-private
# S3_PUBLIC_URL=https://quickpark-public.s3.ap-south-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # only for MinIO / other S3-compatible stores

# ---- Payments: mock (local) or razorpay ----
PAYMENTS_DRIVER=mock
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_API_WS_URL=http://localhost:4000

# ---- Production extras ----
# Public site address for link previews, sitemap and canonical URLs (defaults to the first WEB_ORIGIN)
NEXT_PUBLIC_SITE_URL=
# Swagger UI at /api/docs: on by default except in production
# API_DOCS=false
# Error tracking (Sentry): backend + Next.js server, and the browser. Empty = off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
