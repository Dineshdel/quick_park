{
  "name": "@qp/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "seed:admin": "nest build && node dist/admin/seed-admin.cli.js",
    "seed:demo": "nest build && node dist/admin/seed-demo.cli.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1178.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/platform-socket.io": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/websockets": "11.2.11",
    "@prisma/client": "6.19.3",
    "@qp/types": "workspace:*",
    "@qp/validation": "workspace:*",
    "@sentry/nestjs": "9.47.2",
    "argon2": "0.44.0",
    "bullmq": "5.81.6",
    "cookie-parser": "1.4.7",
    "google-auth-library": "10.9.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.6.1",
    "pdfkit": "0.17.2",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/multer": "2.0.0",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "dotenv-cli": "10.0.0",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
