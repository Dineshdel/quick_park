{
  "expo": {
    "name": "Quick Park",
    "slug": "quick-park",
    "scheme": "quickpark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickpark.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Quick Park uses the camera to scan parking passes and vehicle stickers at the gate.",
        "NSLocationWhenInUseUsageDescription": "Quick Park uses your location to find parking near you.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quickpark.app",
      "adaptiveIcon": {
        "backgroundColor": "#1b2240",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Quick Park uses the camera to scan parking passes and vehicle stickers at the gate.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quick Park uses your location to find parking near you."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#fbf9f4",
          "dark": {
            "backgroundColor": "#121731"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
